  "lessons": [
    {
      "id": "L00",
      "priority": 100,
      "title": "CPU 复位后的第一条指令",
      "stage": "boot",
      "profileId": "linux-x86_64",
      "trigger": {
        "address": "0xfffffff0"
      },
      "execution": {
        "runTo": "next-instruction",
        "interruptPolicy": "disable",
        "budgetInstructions": 1
      },
      "observe": {
        "registers": [
          "rip",
          "cs"
        ],
        "memory": [],
        "devices": [],
        "coverage": "best-effort"
      },
      "focus": {
        "cpuFields": [
          "rip",
          "cs",
          "cr0"
        ],
        "addresses": [
          "0xfffffff0",
          "0xffff0"
        ]
      },
      "explain": {
        "purpose": "观察 CPU 复位后第一条取指：CS 隐藏基址由硬件设定，IP 从 0xfff0 开始。",
        "io": "CPU 从复位向量取指，随后跳入固件。",
        "instructions": {
          "0xfffffff0": "复位向量处的第一条指令；结合地址、反汇编和原始字节核对。",
          "jmp far": "固件随后用远跳转刷新 CS，进入真正的 16 位初始化代码。"
        },
        "concepts": [
          "复位时使用段缓存中由硬件设定的 CS 基址，与 IP 相加得到取指地址。",
          "此时的取指来自 ROM/固件映射，观察地址按该阶段的 CPU 模式和物理映射解释。"
        ],
        "fieldRefs": [
          "cpu.linearPc",
          "cpu.segments.cs",
          "cpu.instruction.bytes",
          "cpu.control.cr0"
        ]
      },
      "checks": [
        {
          "description": "已进入复位停点",
          "expect": [
            {
              "field": "stop.reason",
              "equals": "reset"
            }
          ]
        }
      ],
      "questions": [
        {
          "prompt": "0xfff0 对应哪个物理地址？复位时 CS 隐藏基址由谁设定，如何参与计算？",
          "evidenceRefs": [
            "cpu.segments.cs",
            "cpu.instruction"
          ]
        }
      ],
      "evidence": [
        "x-oslab-capture",
        "rom-bytes"
      ]
    },
    {
      "id": "L01",
      "priority": 80,
      "title": "固件把启动扇区装到 0x7c00",
      "stage": "boot",
      "profileId": "linux-x86_64",
      "trigger": {
        "addressRange": [
          "0x7000",
          "0x10000"
        ]
      },
      "execution": {
        "runTo": "next-instruction",
        "interruptPolicy": "defer",
        "budgetInstructions": 1
      },
      "observe": {
        "registers": [
          "rip",
          "cs",
          "ds"
        ],
        "memory": [],
        "devices": [],
        "coverage": "best-effort"
      },
      "focus": {
        "cpuFields": [
          "rip",
          "cs",
          "ds"
        ],
        "addresses": [
          "0x7c00",
          "0x7c1f"
        ]
      },
      "explain": {
        "purpose": "看固件/引导器在实模式下的装载位置和下一步跳转。",
        "io": "SeaBIOS 的磁盘服务读取 MBR，把 512 字节装到 0x7c00；控制权交给引导扇区。",
        "instructions": {
          "int 0x13": "BIOS 磁盘中断；真实扇区内容由 QEMU 的 IDE 设备提供。",
          "jmp 0x0000:0x7c00": "固件移交控制权，CS:IP 一起改变。"
        },
        "concepts": [
          "MBR 只有 512 字节并以 0x55aa 结尾，第二阶段引导器在别处。",
          "GRUB 的实际装载地址从本次运行读取，并用于绑定符号。"
        ],
        "fieldRefs": [
          "cpu.linearPc",
          "cpu.segments.cs",
          "memory"
        ]
      },
      "checks": [],
      "questions": [
        {
          "prompt": "0x7c00 处的字节与启动盘 MBR 是否一致？",
          "evidenceRefs": [
            "memory",
            "disk"
          ]
        }
      ],
      "evidence": [
        "bios-rom-map",
        "disk-mbr"
      ]
    },
    {
      "id": "L02",
      "priority": 80,
      "title": "Linux 16 位 setup",
      "stage": "boot",
      "profileId": "linux-x86_64",
      "trigger": {
        "module": "linux-setup",
        "symbol": [
          "main",
          "go_to_protected_mode",
          "protected_mode_jump"
        ]
      },
      "execution": {
        "runTo": "symbol",
        "target": "go_to_protected_mode",
        "interruptPolicy": "defer",
        "budgetInstructions": 100000
      },
      "observe": {
        "registers": [
          "cr0",
          "cs",
          "ds",
          "esp"
        ],
        "memory": [],
        "devices": [],
        "coverage": "best-effort"
      },
      "focus": {
        "cpuFields": [
          "mode",
          "cr0",
          "cs",
          "esp"
        ],
        "source": {
          "module": "linux-setup",
          "symbol": "main"
        }
      },
      "explain": {
        "purpose": "GRUB 用 linux16 协议进入 Linux setup；setup 收集 boot_params、内存图并准备进入保护模式。",
        "io": "setup 读取 boot_params、建立栈和描述符表，最后跳到 protected_mode_jump。",
        "instructions": {
          "cli": "进入关键切换前关闭中断。",
          "lgdt": "装载 setup 的 GDT；描述符表内容应从当前内存读取。",
          "mov cr0": "置 PE 位进入保护模式；随后的远跳转刷新 CS。"
        },
        "concepts": [
          "16 位 setup 与 32 位解压器是不同模块，符号必须按装载地址绑定。",
          "boot_params 是真实内存对象，字段值由本次启动决定。"
        ],
        "fieldRefs": [
          "cpu.mode",
          "cpu.control.cr0",
          "cpu.segments.cs",
          "source"
        ]
      },
      "checks": [],
      "questions": [
        {
          "prompt": "CR0.PE 置位前后 CS 的属性有什么变化？",
          "evidenceRefs": [
            "cpu.segments.cs",
            "cpu.control.cr0"
          ]
        }
      ],
      "evidence": [
