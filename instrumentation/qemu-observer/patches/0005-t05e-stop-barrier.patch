 static void virtio_blk_free_request(VirtIOBlockReq *req)
 {
+    /*
+     * x-oslab（T05e）：请求对象销毁时无条件清掉台账条目。
+     *
+     * 正常路径上 virtio_blk_req_complete() 已经移除了它，这里是幂等的第二道
+     * 保险；真正需要它的是一条真实的删除路径：virtio_blk_reset() 与
+     * virtio_blk_dma_restart_bh() 的 purge 分支对挂在 s->rq 上的请求直接
+     * virtqueue_detach_element() + free，既不写状态字节也不发 block.complete。
+     * 少了这道保险，那个请求会永远留在台账里（pending 数虚高），而且描述符索引
+     * 一旦被复用，新请求会和幽灵条目撞上同一个 requestId。
+     */
+    if (req->dev != NULL) {
+        x_oslab_block_inflight_visible(
+            VIRTIO_DEVICE(req->dev)->x_oslab_dev_id,
+            x_oslab_block_request_id(req));
+    }
     g_free(req);
 }
 
