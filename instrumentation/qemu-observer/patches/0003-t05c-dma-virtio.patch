+    /*
+     * 设备没注册（x_oslab_dev_id == 0）时不产生事件：宁可不报，也不报一条
+     * 归属不明的记录。关闭采集时 x_oslab_event_dma() 自己会早退。
+     */
+    if (elem == NULL || vdev->x_oslab_dev_id == 0) {
+        return;
+    }
+
+    request_id = X_OSLAB_REQUEST_ID(vq->queue_index, elem->index);
+    for (i = 0; i < elem->out_num; i++) {
+        /* 单项描述符长度是 32 位（VRingDesc.len / VRingPackedDesc.len），
+         * 映射出的 iov_len 不会超过它，收窄到 uint32_t 不会截断。 */
+        x_oslab_event_dma(false, vdev->x_oslab_dev_id, request_id,
+                          elem->out_addr[i],
+                          (uint32_t)elem->out_sg[i].iov_len);
+    }
+    for (i = 0; i < elem->in_num; i++) {
+        x_oslab_event_dma(true, vdev->x_oslab_dev_id, request_id,
+                          elem->in_addr[i],
+                          (uint32_t)elem->in_sg[i].iov_len);
+    }
