{
  "name": "linux-observatory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node services/lab-server/main.mjs",
    "web:dev": "vite --config apps/debugger-web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/debugger-web/vite.config.ts",
    "start": "node services/lab-server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:lab": "node scripts/verify-lab.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "clean:sessions": "node scripts/clean-sessions.mjs",
    "verify:all": "npm test && npm run verify:lab && npm run verify:ui"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "playwright": "^1.56.0"
  }
}
